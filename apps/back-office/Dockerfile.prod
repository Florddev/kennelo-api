# syntax=docker/dockerfile:1.7

# Stage 1 — deps
# Installs all monorepo dependencies (pnpm workspace).
FROM node:24-alpine AS deps

RUN corepack enable && corepack prepare pnpm@10.4.1 --activate
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/back-office/package.json ./apps/back-office/
COPY packages/common/package.json ./packages/common/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/modules/package.json ./packages/modules/
COPY packages/prettier-config/package.json ./packages/prettier-config/
COPY packages/translations/package.json ./packages/translations/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/ui/package.json ./packages/ui/

RUN pnpm install --frozen-lockfile

# Stage 2 — builder
# Builds the back-office Next.js app in standalone mode.
FROM node:24-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.4.1 --activate
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/apps/back-office/node_modules ./apps/back-office/node_modules
COPY --from=deps /repo/packages ./packages
COPY . .

ARG NEXT_PUBLIC_API_URL="http://localhost:8000/api"

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter back-office build

# Stage 3 — runner
# Minimal production image: Node + standalone server only.

FROM node:24-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /repo/apps/back-office/.next/standalone ./

COPY --from=builder --chown=nextjs:nodejs /repo/apps/back-office/.next/static ./apps/back-office/.next/static
COPY --from=builder --chown=nextjs:nodejs /repo/apps/back-office/public ./apps/back-office/public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "apps/back-office/server.js"]
