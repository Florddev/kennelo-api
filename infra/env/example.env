# example.env — Template documenté des variables d'environnement de déploiement.
# Chaque environnement a son fichier : prod.env, preprod.env.
# Ces fichiers sont sourcés par les scripts de déploiement (set -a) puis
# interpolés dans les stacks infra/stacks/*.yml via ${VAR}.
#
# RÈGLE ABSOLUE : aucun secret ici. Mots de passe, clés API, tokens et
# certificats vont exclusivement dans les Docker Secrets (voir bootstrap.sh).
#
# Discipline : toute nouvelle variable ajoutée à une stack doit AUSSI être
# ajoutée ici, avec son commentaire.

# Tag des images applicatives GHCR (kennelo-api, kennelo-web).
# ${IMAGE_TAG:-...} permet l'override par l'appelant : IMAGE_TAG=v0.2.0 ./deploy-app.sh
# préprod : main (dernier merge) — prod : prod (dernière release) ou vX.Y.Z précis
IMAGE_TAG="${IMAGE_TAG:-main}"

# Nombre de replicas des services applicatifs.
# prod : 2 (HA sur les workers) — préprod : 1 (mono-nœud, économie de RAM)
API_REPLICAS=2
WEB_REPLICAS=2
REVERB_REPLICAS=2

# URL publique de l'API Laravel (APP_URL).
APP_URL=https://api.kennelo.fr

# URL publique du front web (FRONTEND_URL côté Laravel).
FRONTEND_URL=https://kennelo.fr

# Origines autorisées par le CORS de l'API (séparées par des virgules).
CORS_ALLOWED_ORIGINS="https://kennelo.fr,https://www.kennelo.fr"

# Mapping domaine → locale par défaut côté Laravel.
DOMAIN_LOCALES="kennelo.fr:fr,kennelo.com:en"

# URL publique des médias MinIO (AWS_URL Laravel, incluant le bucket).
AWS_URL=https://cdn.kennelo.fr/kennelo-media

# Hostname public du serveur WebSocket Reverb (REVERB_HOST).
REVERB_PUBLIC_HOST=ws.kennelo.fr
