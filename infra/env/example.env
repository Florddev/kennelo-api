# example.env — Template documenté des variables d'environnement de déploiement.
# Chaque environnement a son fichier : prod.env, preprod.env.
# Ces fichiers sont sourcés par les scripts de déploiement (set -a) puis
# interpolés dans les stacks infra/stacks/*.yml via ${VAR}.
#
# RÈGLE ABSOLUE : aucun secret ici. Mots de passe, clés API, tokens et
# certificats vont exclusivement dans les Docker Secrets (voir bootstrap.sh).
#
# Discipline : toute nouvelle variable ajoutée à une stack doit AUSSI être
# ajoutée ici, avec son commentaire.

# Tag des images applicatives GHCR (kennelo-api, kennelo-web).
# ${IMAGE_TAG:-...} permet l'override par l'appelant : IMAGE_TAG=v0.2.0 ./deploy-app.sh
# préprod : preprod-latest (dernier merge sur main)
# prod : prod (dernière release) ou vX.Y.Z précis (rollback, reproductibilité)
IMAGE_TAG="${IMAGE_TAG:-preprod-latest}"

# Nombre de replicas des services applicatifs.
# prod : 2 (HA sur les workers) — préprod : 1 (mono-nœud, économie de RAM)
# Le back-office reste à 1 partout (outil interne, pas de besoin de HA).
API_REPLICAS=2
WEB_REPLICAS=2
REVERB_REPLICAS=2
BACK_OFFICE_REPLICAS=1

# URL publique de l'API Laravel (APP_URL).
APP_URL=https://api.kennelo.fr

# URL publique du front web (FRONTEND_URL côté Laravel).
FRONTEND_URL=https://kennelo.fr

# Origines autorisées par le CORS de l'API (séparées par des virgules).
# Doit inclure le domaine du back-office (admin.*), qui appelle l'API
# depuis sa propre origine.
CORS_ALLOWED_ORIGINS="https://kennelo.fr,https://www.kennelo.fr,https://admin.kennelo.fr"

# Mapping domaine → locale par défaut côté Laravel.
DOMAIN_LOCALES="kennelo.fr:fr,kennelo.com:en"

# URL publique des médias MinIO (AWS_URL Laravel, incluant le bucket).
AWS_URL=https://cdn.kennelo.fr/kennelo-media

# Hostname public du serveur WebSocket Reverb (REVERB_HOST).
REVERB_PUBLIC_HOST=ws.kennelo.fr

# Client OAuth Google — un seul client partagé entre prod et préprod.
# Le client_id est public par nature : inliné au build web (NEXT_PUBLIC_,
# consommé par Google Identity Services) et lu par l'API Laravel via
# config/services.php.
# Le GOOGLE_CLIENT_SECRET n'est PAS une variable d'environnement : c'est un
# Docker Secret (kennelo_google_client_secret), créé manuellement car la
# valeur vient de la Google Cloud Console — voir bootstrap.sh.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=

# Emailing (Resend). MAIL_FROM_ADDRESS sur un domaine vérifié Resend.
# RESEND_KEY est un Docker Secret (kennelo_resend_api_key) — voir bootstrap.sh.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@kennelo.com
MAIL_FROM_NAME=Kennelo

# Clé publishable Stripe (pk_*, publique par nature — inlinée au build web).
# Clé de test partagée prod+préprod tant qu'aucun paiement réel n'est traité ;
# passer prod.env en pk_live le jour venu.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
