# prod.env — Configuration de déploiement de la production.
# Aucun secret ici (voir example.env pour la règle et la doc des variables).

# TODO première release : passer le défaut à "prod" une fois le premier tag
# git vX.Y.Z poussé et l'image :prod publiée par la CI. Tant que le défaut
# est "main", le comportement est identique à l'existant.
IMAGE_TAG="${IMAGE_TAG:-main}"

API_REPLICAS=2
WEB_REPLICAS=2
REVERB_REPLICAS=2

APP_URL=https://api.kennelo.fr
FRONTEND_URL=https://kennelo.fr
CORS_ALLOWED_ORIGINS="https://kennelo.fr,https://www.kennelo.fr,https://kennelo.com,https://www.kennelo.com"
DOMAIN_LOCALES="kennelo.fr:fr,kennelo.com:en,kennelo.it:it,kennelo.be:fr,kennelo.de:de"
AWS_URL=https://cdn.kennelo.fr/kennelo-media
REVERB_PUBLIC_HOST=ws.kennelo.fr
