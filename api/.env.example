APP_NAME=Kennelo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.kennelo.fr,https://kennelo.fr,https://kennelo.com,https://www.kennelo.com,https://www.kennelo.it,https://www.kennelo.be,https://www.kennelo.de

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Multi-domain i18n configuration
DOMAIN_LOCALES=kennelo.fr:fr,kennelo.com:en,kennelo.be:fr
DEFAULT_LOCALE=en
AVAILABLE_LOCALES=en,fr,ar
GEOIP_SERVICE_URL=https://ipapi.co
GEOIP_CACHE_TTL=3600

# JWT Authentication Configuration
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TOKEN_TTL=43200
JWT_LEEWAY=60
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kennelo
DB_USERNAME=kennelo
DB_PASSWORD=kennelo_dev_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=kennelo_dev_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=kennelo
AWS_SECRET_ACCESS_KEY=kennelo_dev_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kennelo-media
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/kennelo-media

MEDIA_DISK=s3

VITE_APP_NAME="${APP_NAME}"
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.1

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=kennelo
REVERB_APP_KEY=kennelo-key
REVERB_APP_SECRET=kennelo-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

BOOKING_USER_SERVICE_FEE_RATE=0.08
BOOKING_HOST_COMMISSION_RATE=0.06
BOOKING_ACCEPTANCE_WINDOW_HOURS=72
BOOKING_PAYOUT_DELAY_HOURS=24
BOOKING_REMINDER_AFTER_HOURS=36

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_SOURCE_LOCALE=en