APP_NAME=Kennelo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
AVAILABLE_LOCALES=en,fr,ar

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Authentification des fronts par cookie de session (Sanctum, mode SPA).
# Les fronts et l'API doivent partager le même domaine parent (en production : SESSION_DOMAIN=.kennelo.fr).
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kennelo_v2
DB_USERNAME=kennelo
DB_PASSWORD=kennelo_dev_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=kennelo_dev_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Stockage des médias (MinIO en développement)
AWS_ACCESS_KEY_ID=kennelo
AWS_SECRET_ACCESS_KEY=kennelo_dev_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kennelo-media
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/kennelo-media

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_SOURCE_LOCALE=en

# API publique de recherche d'entreprises (SIREN)
RECHERCHE_ENTREPRISES_URL=https://recherche-entreprises.api.gouv.fr

# Activités (valeurs par défaut dans config/activities.php). Le disque des justificatifs doit rester privé.
# ACTIVITY_DEFAULT_TIMEZONE=Europe/Paris
# ACTIVITY_MAX_RADIUS_KM=200
# ACTIVITY_DEFAULT_SEARCH_RADIUS_KM=30
# ACTIVITY_DOCUMENTS_DISK=local
# ACTIVITY_DOCUMENTS_EXPIRY_NOTICE_DAYS=30

# Réservations (valeurs par défaut dans config/booking.php ; frais et délais modifiables dans le back-office).
# BOOKING_USER_SERVICE_FEE_RATE=0.08
# BOOKING_HOST_COMMISSION_RATE=0.06
# BOOKING_ACCEPTANCE_WINDOW_HOURS=72
# BOOKING_PAYOUT_DELAY_HOURS=24
# BOOKING_REMINDER_AFTER_HOURS=36
# BOOKING_VAT_RATE=20.00
# BOOKING_MAX_STAY_DAYS=90

# Agenda et rendez-vous (valeurs par défaut dans config/agenda.php).
# AGENDA_SLOT_STEP_MINUTES=15
# AGENDA_MIN_NOTICE_MINUTES=120
# AGENDA_MAX_RANGE_DAYS=31
# AGENDA_MAX_PETS_PER_APPOINTMENT=5

# Valeurs par défaut dans config/auth.php (minutes, sauf l'expiration du mot de passe en jours)
# AUTH_TWO_FACTOR_CHALLENGE_TTL=5
# AUTH_PASSWORD_RENEWAL_TTL=15
# AUTH_MAGIC_LINK_EXPIRE=15
# AUTH_PASSWORD_EXPIRY_DAYS=60

# Frais et quotas : valeurs par défaut dans config/booking.php et config/plans.php
