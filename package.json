{
    "name": "kennelo",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
        "barrels": "turbo run barrels",
        "clean": "pnpm --recursive exec rm -rf node_modules .turbo .next dist out && pnpm store prune",
        "build:translations": "pnpm --filter @workspace/translations build",
        "test:e2e": "pnpm --filter web test:e2e",
        "test:e2e:ui": "pnpm --filter web test:e2e:ui",
        "test:e2e:headed": "pnpm --filter web test:e2e:headed"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "@workspace/eslint-config": "workspace:*",
        "@workspace/prettier-config": "workspace:*",
        "@workspace/typescript-config": "workspace:*",
        "barrelsby": "^2.8.1",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "turbo": "^2.9.16",
        "typescript": "5.9.3"
    },
    "packageManager": "pnpm@10.4.1",
    "engines": {
        "node": ">=20"
    },
    "pnpm": {
        "overrides": {
            "sharp": "^0.33.0",
            "postcss": "^8.5.10",
            "shell-quote": "^1.8.4",
            "minimatch@3": ">=3.1.4",
            "minimatch@9": ">=9.0.7",
            "minimatch@10": ">=10.2.3",
            "tar": ">=7.5.16",
            "@xmldom/xmldom": ">=0.8.13",
            "tmp": ">=0.2.6",
            "ip-address": ">=10.1.1",
            "js-yaml": ">=4.2.0",
            "@babel/core": ">=7.29.6",
            "uuid": ">=11.1.1",
            "@turbo/workspaces": ">=2.9.14"
        }
    }
}
