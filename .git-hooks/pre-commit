#!/bin/sh

BOLD='\033[1m'
NC='\033[0m'

BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH_NAME" = "HEAD" ]; then
    exit 0
fi

VALID_BRANCH_PATTERN="^(feature|fix|chore)/(api|web|infra)/.+"

if ! echo "$BRANCH_NAME" | grep -qE "$VALID_BRANCH_PATTERN"; then
    echo "❌ Invalid branch name: $BRANCH_NAME"
    echo ""
    echo "Branch name must follow this format:"
    echo "  - feature/{api|web|infra}/description"
    echo "  - fix/{api|web|infra}/description"
    echo "  - chore/{api|web|infra}/description"
    echo ""
    echo "To rename your current branch:"
    echo "   git branch -m feature/infra/description"
    echo ""
    echo "❌ Invalid branch name: $BRANCH_NAME"
    echo "😎 Signé: le petit blond relou 😘"
    exit 1
fi

echo -e "✅ Valid branch name: $BRANCH_NAME ${BOLD}bravo tié le goat${NC}"
echo ""
echo -e "${BOLD}Running API checks...${NC}"

API_FILES=$(git diff --cached --name-only | grep -E "^api/" || true)

if [ -n "$API_FILES" ]; then
    echo "API files detected, running Pint and PHPStan..."

    if [ ! -d "api" ]; then
        echo "❌ API directory not found!"
        exit 1
    fi

    cd api

    if [ ! -d "vendor" ]; then
        echo "❌ Run 'composer install' in api/ first"
        exit 1
    fi

    echo "Running Pint..."

    cd ..
    git diff --name-only > /tmp/before_pint
    cd api

    vendor/bin/pint -v
    PINT_EXIT_CODE=$?

    cd ..
    git diff --name-only > /tmp/after_pint

    PINT_MODIFIED=$(comm -13 /tmp/before_pint /tmp/after_pint)

    if [ -n "$PINT_MODIFIED" ]; then
        echo "Pint has modified files, adding them to commit:"
        echo "$PINT_MODIFIED"
        echo "$PINT_MODIFIED" | xargs git add
    fi

    rm -f /tmp/before_pint /tmp/after_pint

    cd api

    if [ $PINT_EXIT_CODE -ne 0 ]; then
        echo "❌ Pint failed"
        exit 1
    fi

    echo "Running PHPStan..."
    if ! vendor/bin/phpstan analyse --memory-limit=2G; then
        echo "❌ PHPStan failed"
        exit 1
    fi

    cd ..

    echo "✅ API checks passed"
else
    echo "No API files to check"
fi
echo ""
echo -e "${BOLD}Running Prettier checks...${NC}"

PRETTIER_FILES=$(git diff --cached --name-only | grep -E "\.(js|jsx|ts|tsx|json|css|scss|md)$" || true)

if [ -n "$PRETTIER_FILES" ]; then
    echo "Files detected, running Prettier..."

    if ! command -v pnpm &> /dev/null; then
        echo "❌ pnpm not found, install it first"
        exit 1
    fi

    if [ ! -d "node_modules" ]; then
        echo "❌ Run 'pnpm install' first"
        exit 1
    fi

    echo "Running Prettier with auto-fix..."

    git diff --name-only > /tmp/before_prettier

    pnpm format
    PRETTIER_EXIT_CODE=$?

    git diff --name-only > /tmp/after_prettier

    PRETTIER_MODIFIED=$(comm -13 /tmp/before_prettier /tmp/after_prettier)

    if [ -n "$PRETTIER_MODIFIED" ]; then
        echo "Prettier has modified files, adding them to commit:"
        echo "$PRETTIER_MODIFIED"
        echo "$PRETTIER_MODIFIED" | xargs git add
    fi

    rm -f /tmp/before_prettier /tmp/after_prettier

    if [ $PRETTIER_EXIT_CODE -ne 0 ]; then
        echo "❌ Prettier failed"
        exit 1
    fi

    echo "✅ Prettier passed"
else
    echo "No files to format"
fi
echo ""
echo -e "${BOLD}Running Frontend checks...${NC}"

FRONTEND_FILES=$(git diff --cached --name-only | grep -E "^(apps/|packages/)" || true)

if [ -n "$FRONTEND_FILES" ]; then
    echo "Frontend files detected, running ESLint..."

    if ! command -v pnpm &> /dev/null; then
        echo "❌ pnpm not found, install it first"
        exit 1
    fi

    if [ ! -d "node_modules" ]; then
        echo "❌ Run 'pnpm install' first"
        exit 1
    fi

    echo "Running ESLint with auto-fix..."

    git diff --name-only > /tmp/before_eslint

    pnpm lint:fix
    ESLINT_EXIT_CODE=$?

    git diff --name-only > /tmp/after_eslint

    ESLINT_MODIFIED=$(comm -13 /tmp/before_eslint /tmp/after_eslint)

    if [ -n "$ESLINT_MODIFIED" ]; then
        echo "ESLint has modified files, adding them to commit:"
        echo "$ESLINT_MODIFIED"
        echo "$ESLINT_MODIFIED" | xargs git add
    fi

    rm -f /tmp/before_eslint /tmp/after_eslint

    if [ $ESLINT_EXIT_CODE -ne 0 ]; then
        echo "❌ ESLint failed"
        exit 1
    fi

    echo "✅ ESLint passed"
else
    echo "No frontend files to check"
fi
echo ""
echo -e "All checks passed ${BOLD}bravo tié un congélateur${NC}"
exit 0